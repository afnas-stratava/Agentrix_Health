# Base URL of the lab-parsing / insight backend.
# Leave EMPTY to run the app fully offline against the deterministic local
# fixture parser in src/features/labs/parser.mock.ts
EXPO_PUBLIC_API_BASE_URL=

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Toggles verbose HealthKit + correlation-engine logging.
EXPO_PUBLIC_DEBUG_TELEMETRY=false
