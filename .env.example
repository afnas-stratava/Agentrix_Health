# Base URL of the lab-parsing / Gmail-scanning backend.
# Leave EMPTY to run the app fully offline against on-device fixtures
# (src/features/labs/parser.mock.ts and src/features/labs/gmail/client.mock.ts)
EXPO_PUBLIC_API_BASE_URL=

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Toggles verbose HealthKit + correlation-engine logging.
EXPO_PUBLIC_DEBUG_TELEMETRY=false

# ---------------------------------------------------------------------------
# Gmail import
# ---------------------------------------------------------------------------
# Google OAuth *iOS client* ID from the Google Cloud console. This value is
# public by design and ships in the bundle — the client secret must live ONLY
# on the backend, which exchanges the authorization code for tokens.
#
# The app requests https://www.googleapis.com/auth/gmail.readonly, a Google
# "Restricted" scope. Until OAuth verification + CASA assessment complete, only
# accounts added as Test Users in the Cloud console can connect.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ---------------------------------------------------------------------------
# Restaurant recommendations
# ---------------------------------------------------------------------------
# Google Places API (New) key, used for the nearby-restaurant search.
#
# Unlike the OAuth client ID above this is a real credential that ships in the
# bundle, so it MUST be restricted in the Cloud console to:
#   • Application restriction → iOS apps → com.vitals.health
#   • API restriction        → Places API (New) only
# Leave EMPTY to run the dining feature against the curated fixture venues in
# src/features/dining/fixtures.ts — the app degrades to those automatically if
# the key is missing, the quota is exhausted, or the network is down.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
