<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: lets the app call the dev FastAPI backend over
         plain http:// (e.g. http://192.168.x.x:8000). Android blocks
         cleartext traffic by default since API 28; release builds must use
         https instead of re-enabling this. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
